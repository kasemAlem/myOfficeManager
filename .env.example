# -----------------------------
# APP SETTINGS & BRANDING
# -----------------------------
NEXT_PUBLIC_APP_NAME="Management OS"
NEXT_PUBLIC_COMPANY_NAME="Acme Corporation"
NEXT_PUBLIC_APP_LOGO=""
NEXT_PUBLIC_CURRENCY_SYMBOL="₪"
NEXT_PUBLIC_CURRENCY_CODE="ILS"
NEXT_PUBLIC_LOCALE="he-IL"

# -----------------------------
# INITIAL ADMIN PROVISIONING
# -----------------------------
INITIAL_ADMIN_EMAIL="admin@acme.com"
INITIAL_ADMIN_PASSWORD="SecurePassword123!"
INITIAL_ADMIN_NAME="System Administrator"

# -----------------------------
# SECURITY & DATABASE
# -----------------------------
DATABASE_URL="postgresql://postgres:password123@localhost:5432/officemanager?schema=public"
JWT_SECRET="generate-a-strong-random-secret-here"

# -----------------------------
# SMTP EMAIL CONFIGURATION
# -----------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="user"
SMTP_PASS="pass"
FROM_EMAIL="noreply@acme.com"

# -----------------------------
# DATABASE BACKUP CONFIGURATION
# -----------------------------
# Local directory for backup files (default: ./backups)
BACKUP_DIR="./backups"
# Cron schedule expression (default: daily at midnight)
BACKUP_CRON_SCHEDULE="0 0 * * *"
# Google Drive folder ID (extract from Drive URL, leave empty to skip GDrive)
GOOGLE_DRIVE_FOLDER_ID=""
# Path to GCP Service Account JSON (required only if GOOGLE_DRIVE_FOLDER_ID is set)
GOOGLE_APPLICATION_CREDENTIALS=""
