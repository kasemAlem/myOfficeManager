{
  "name": "officemanager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3007",
    "build": "next build",
    "start": "next start --port 3007",
    "lint": "eslint",
    "db:clean": "npx prisma db push --force-reset && node scripts/reset_deploy.js",
    "backup": "node scripts/backup.js",
    "backup:schedule": "node scripts/backup.js --schedule",
    "restore": "node scripts/restore.js",
    "restore:list": "node scripts/restore.js --list",
    "db:migrate": "prisma migrate deploy",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^7.0.0",
    "@types/nodemailer": "^8.0.0",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
